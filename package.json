{
  "name": "trpg-platform",
  "private": true,
  "workspaces": [
    "fe",
    "be",
    "shared-types",
    "srd-data"
  ],
  "scripts": {
    "build": "npm run build -w @trpg/shared-types && echo [build] @trpg/shared-types completed && npm run build -w @trpg/srd-data && npm run sync:fe:srd && npm run build -w @trpg/be && echo [build] @trpg/be completed && npm run build -w @trpg/fe",
    "dev": "npm run build -w @trpg/shared-types && npm run build -w @trpg/srd-data && npm run start:dev -w @trpg/be",
    "dev:be": "npm run build -w @trpg/shared-types && npm run build -w @trpg/srd-data && npm run start:dev -w @trpg/be",
    "dev:fe": "npm run dev -w @trpg/fe",
    "sync:fe:srd": "node scripts/sync-fe-static-srd.mjs",
    "cleanup:guests": "node scripts/cleanup-guest-users.mjs",
    "cleanup:guests:apply": "node scripts/cleanup-guest-users.mjs --apply",
    "backfill:scenario-publication": "node scripts/backfill-scenario-publication.mjs",
    "backfill:scenario-publication:apply": "node scripts/backfill-scenario-publication.mjs --apply",
    "check:scenario-projection": "node scripts/backfill-scenario-publication.mjs --require-ready",
    "backfill:ai-trace-fallback": "node scripts/backfill-ai-trace-fallback.mjs",
    "backfill:ai-trace-fallback:apply": "node scripts/backfill-ai-trace-fallback.mjs --apply",
    "check:ai-trace-fallback": "node scripts/backfill-ai-trace-fallback.mjs --require-ready",
    "benchmark:performance:api": "node scripts/performance/run-api-benchmark.mjs",
    "benchmark:performance:moderation": "node scripts/performance/run-moderation-fanout-benchmark.mjs",
    "benchmark:performance:seed": "node scripts/performance/seed-scale.mjs",
    "benchmark:performance:vtt": "npm run --silent build -w @trpg/shared-types && node scripts/performance/benchmark-vtt-payload.mjs",
    "benchmark:performance:vtt-spatial": "tsx scripts/performance/benchmark-vtt-spatial.ts",
    "verify:rule-data-sync": "node scripts/verify-rule-data-sync.mjs",
    "verify:spell-presentation": "node scripts/verify-spell-presentation.mjs",
    "verify:user-facing-identifiers": "node scripts/verify-user-facing-identifiers.mjs",
    "test:ux-e2e": "npm run test:e2e:a11y -w @trpg/fe",
    "test": "npm run --silent test:quiet -w @trpg/be",
    "test:log": "npm run --silent test:log -w @trpg/be",
    "test:e2e": "npm run test:e2e -w @trpg/be",
    "eval:ai-quality": "npm run eval:ai-quality -w @trpg/be",
    "test:p0-regression": "npm run test:p0-regression -w @trpg/be",
    "test:p1-regression": "npm run test:p1-regression -w @trpg/be",
    "test:p2-regression": "npm run test:p2-regression -w @trpg/be",
    "test:p3-regression": "npm run test:p3-regression -w @trpg/be",
    "test:p4-regression": "npm run test:p4-regression -w @trpg/be",
    "test:p5-regression": "npm run test:p5-regression -w @trpg/be",
    "test:p6-regression": "npm run test:p6-regression -w @trpg/be",
    "prisma:generate": "npm run prisma:generate -w @trpg/be",
    "prisma:push": "npm run prisma:push -w @trpg/be",
    "seed": "npm run seed -w @trpg/be"
  }
}
