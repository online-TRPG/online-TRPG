{
  "name": "@trpg/shared-types",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "require": "./dist/frontend.js",
      "default": "./dist/frontend.js"
    },
    "./browser-runtime": {
      "types": "./dist/browser-runtime.d.ts",
