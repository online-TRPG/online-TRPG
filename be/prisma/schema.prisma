generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  RECRUITING
  PLAYING
  PAUSED
  COMPLETED
  DISBANDED
}

enum SessionVisibility {
  PUBLIC
  PRIVATE
}

enum SessionScenarioStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ParticipantRole {
  HOST
  GM
  PLAYER
  SPECTATOR
}

enum ParticipantStatus {
  JOINED
  LEFT
  KICKED
}

enum ConnectionStatus {
  ONLINE
  OFFLINE
}

enum GamePhase {
  LOBBY
  EXPLORATION
  COMBAT
  DIALOGUE
  REST
}

enum AuthProvider {
  LOCAL
  KAKAO
  DISCORD
  GUEST
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum GmMode {
  AI
  HUMAN
}

enum ScenarioLicense {
  ORIGINAL
  CC_BY_4_0
  OTHER_FREE
}

enum AiTraceKind {
  NARRATION
  CHECK_RESULT
  HINT
  SUMMARY
  NPC_DIALOGUE
  INTERPRETER
  ACTOR
}

enum AiTraceStatus {
  SUCCESS
  TIMEOUT
  ERROR
}

enum ScenarioSourceType {
  SYSTEM
  USER
  CLONED
}

enum ScenarioAssetKind {
  MAP
  SCENE
  TOKEN
}

enum SessionCharacterStatus {
  ACTIVE
  RETIRED
  DEAD
  LEFT
}

enum CharacterAvatarType {
  DEFAULT
  PRESET
  UPLOAD
}

enum ActionQueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum ActionInputType {
  TEXT
  SELECT
  COMMAND
}

enum ActionScope {
  PARTY_SHARED
  INDIVIDUAL_TURN
}

enum ActionOutcome {
  SUCCESS
  FAILURE
  IMPOSSIBLE
  NO_ROLL
}

enum DiceAdvantageState {
  NORMAL
  ADVANTAGE
  DISADVANTAGE
}

enum CombatStatus {
  ACTIVE
  ENDED
}

enum CombatEntityType {
  PLAYER_CHARACTER
  NPC
  MONSTER
}

model User {
  id                   String               @id @default(cuid())
  publicId             String?              @unique
  displayName          String
  email                String?              @unique
  passwordHash         String?
  authProvider         AuthProvider         @default(GUEST)
  role                 UserRole             @default(USER)
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt
  profile              UserProfile?
  productProgress      UserProductProgress?
  hostedSessions       Session[]            @relation("SessionHost")
  gmSessions           Session[]            @relation("SessionGm")
  participants         SessionParticipant[]
  characters           Character[]
  refreshTokens        RefreshToken[]
  socialAccounts       SocialAccount[]
  createdScenarios     Scenario[]           @relation("ScenarioCreator")
  scenarioCollaboratorGrants ScenarioCollaboratorGrant[]
  uploadedScenarioAssets ScenarioAsset[]    @relation("ScenarioAssetUploader")
  uploadedCharacterAvatarAssets CharacterAvatarAsset[] @relation("CharacterAvatarAssetUploader")
  controlledCharacters SessionCharacter[]
  aiTraces             AiTrace[]
  createdSessionPlays  SessionPlay[]        @relation("SessionPlayCreator")
  sessionApplications  SessionApplication[] @relation("SessionApplicant")
  resolvedApplications SessionApplication[] @relation("SessionApplicationResolver")
  activePlay           UserActivePlay?
  proximityAcknowledgements SessionScheduleProximityAcknowledgement[]
  passwordResetTokens  PasswordResetToken[]
}

enum SessionActivityStatus {
  DORMANT
  LOBBY_OPEN
  PLAYING
  COMPLETED
  DISBANDED
}

enum RecruitmentStatus {
  OPEN
  CLOSED
}

enum SessionJoinPolicy {
  INVITE_ONLY
  APPROVAL_REQUIRED
  OPEN_JOIN
}

enum SessionPlayStatus {
  SCHEDULED
  LOBBY_OPEN
  PLAYING
  FINISHED
  CANCELLED
}

enum SessionAttendanceStatus {
  ATTENDING
  ABSENT
  TENTATIVE
}

enum SessionApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum SessionJoinTiming {
  CURRENT_PLAY
  NEXT_PLAY
}

model UserProductProgress {
  userId               String   @id
  onboardingVersion    Int      @default(1)
  tutorialStartedAt    DateTime?
  firstActionAt        DateTime?
  completedAt          DateTime?
  dismissedAt          DateTime?
  dismissedCoachmarks  String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  userId                    String            @id
  nickname                  String            @unique
  bio                       String?
  profileImageUrl           String?
  representativeCharacterId String?
  visibility                ProfileVisibility @default(PUBLIC)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  representativeCharacter   Character?        @relation("RepresentativeCharacter", fields: [representativeCharacterId], references: [id], onDelete: SetNull)
}

model Session {
  id                String               @id @default(cuid())
  publicId          String?              @unique
  title             String
  description       String               @default("")
  hostUserId        String
  gmUserId          String?
  inviteCode        String               @unique
  status            SessionStatus        @default(RECRUITING)
  activityStatus    SessionActivityStatus @default(DORMANT)
  recruitmentStatus RecruitmentStatus     @default(OPEN)
  joinPolicy        SessionJoinPolicy     @default(OPEN_JOIN)
  visibility        SessionVisibility    @default(PUBLIC)
  maxParticipants   Int                  @default(4)
  ruleSetId         String?
  gmMode            GmMode               @default(AI)
  captainUserId     String?
  nextSessionAt     DateTime?
  currentPlayId     String?               @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  host              User                 @relation("SessionHost", fields: [hostUserId], references: [id])
  gm                User?                @relation("SessionGm", fields: [gmUserId], references: [id], onDelete: SetNull)
  participants      SessionParticipant[]
  sessionScenarios  SessionScenario[]
  sessionCharacters SessionCharacter[]
  aiTraces          AiTrace[]
  playerActions     PlayerAction[]
  turnLogs          TurnLog[]
  diceRollLogs      DiceRollLog[]
  combats           Combat[]
  plays             SessionPlay[]         @relation("SessionPlays")
  currentPlay       SessionPlay?          @relation("CurrentSessionPlay", fields: [currentPlayId], references: [id], onDelete: SetNull)
  applications      SessionApplication[]
  activeUsers       UserActivePlay[]

  @@index([visibility, status, createdAt])
  @@index([visibility, recruitmentStatus, activityStatus, nextSessionAt])
  @@index([hostUserId, updatedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

model SessionParticipant {
  id               String            @id @default(cuid())
  sessionId        String
  userId           String
  role             ParticipantRole   @default(PLAYER)
  status           ParticipantStatus @default(JOINED)
  connectionStatus ConnectionStatus  @default(ONLINE)
  isReady          Boolean           @default(false)
  readyAt          DateTime?
  joinedAt         DateTime          @default(now())
  leftAt           DateTime?
  session          Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionCharacter SessionCharacter? @relation("ParticipantSessionCharacter")
  playAttendances   SessionPlayAttendance[]

  @@unique([sessionId, userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model SessionPlay {
  id                String            @id @default(cuid())
  sessionId         String
  sequence          Int
  status            SessionPlayStatus @default(SCHEDULED)
  scheduledStartAt  DateTime?
  lobbyOpensAt      DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  timeZone          String            @default("Asia/Seoul")
  scheduleVersion   Int               @default(1)
  stateVersion      Int               @default(1)
  summary           String?
  createdByUserId   String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  session           Session           @relation("SessionPlays", fields: [sessionId], references: [id], onDelete: Cascade)
  currentForSession Session?           @relation("CurrentSessionPlay")
  createdBy         User              @relation("SessionPlayCreator", fields: [createdByUserId], references: [id])
  attendances       SessionPlayAttendance[]
  activeUsers       UserActivePlay[]
  proximitySourceAcknowledgements SessionScheduleProximityAcknowledgement[] @relation("ProximitySourcePlay")
  proximityComparedAcknowledgements SessionScheduleProximityAcknowledgement[] @relation("ProximityComparedPlay")

  @@unique([sessionId, sequence])
  @@index([sessionId, status, scheduledStartAt])
}

model SessionPlayAttendance {
  playId         String
  participantId  String
  attendance     SessionAttendanceStatus @default(TENTATIVE)
  isReady        Boolean                 @default(false)
  readyAt        DateTime?
  enteredLobbyAt DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  play           SessionPlay             @relation(fields: [playId], references: [id], onDelete: Cascade)
  participant    SessionParticipant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([playId, participantId])
  @@index([participantId, attendance])
}

model SessionApplication {
  id               String                   @id @default(cuid())
  sessionId        String
  applicantUserId  String
  status           SessionApplicationStatus @default(PENDING)
  note             String?
  joinTiming       SessionJoinTiming?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  session          Session                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  applicant        User                     @relation("SessionApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  resolvedBy       User?                    @relation("SessionApplicationResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([sessionId, applicantUserId])
  @@index([sessionId, status, createdAt])
  @@index([applicantUserId, status])
}

model UserActivePlay {
  userId      String   @id
  playId      String
  sessionId   String
  acquiredAt  DateTime @default(now())
  heartbeatAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  play        SessionPlay @relation(fields: [playId], references: [id], onDelete: Cascade)
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([playId])
  @@index([sessionId])
}

model SessionScheduleProximityAcknowledgement {
  userId                    String
  playId                    String
  comparedPlayId            String
  playScheduleVersion       Int
  comparedScheduleVersion   Int
  acknowledgedAt            DateTime @default(now())
  user                       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  play                       SessionPlay @relation("ProximitySourcePlay", fields: [playId], references: [id], onDelete: Cascade)
  comparedPlay               SessionPlay @relation("ProximityComparedPlay", fields: [comparedPlayId], references: [id], onDelete: Cascade)

  @@id([userId, playId, comparedPlayId])
}

model Race {
  id                   String   @id @default(cuid())
  key                  String   @unique
  koName               String
  size                 String
  baseSpeed            Int
  abilityIncreasesJson String
  languagesJson        String
  parentRaceId         String?
  parentRace           Race?    @relation("RaceSubrace", fields: [parentRaceId], references: [id], onDelete: SetNull)
  subraces             Race[]   @relation("RaceSubrace")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Item {
  id        String   @id @default(cuid())
  key       String   @unique
  koName    String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassDefinition {
  id                    String   @id @default(cuid())
  key                   String   @unique
  koName                String
  hitDie                String
  startingEquipmentJson String
  startingCantripCount  Int      @default(0)
  startingSpellCount    Int      @default(0)
  skillChoicesJson      String   @default("[]")
  skillChoiceCount      Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Character {
  id                     String              @id @default(cuid())
  ownerUserId            String
  scenarioId             String?
  name                   String
  ancestry               String
  className              String
  subclassName           String?
  level                  Int
  bio                    String?
  abilitiesJson          String
  proficiencyBonus       Int
  featuresJson           String?
  proficientSkillsJson   String
  maxHp                  Int
  armorClass             Int
  speed                  Int
  inventoryJson          String
  spellsJson             String?
  equippedWeaponId       String?
  offhandWeaponId        String?
  avatarType             CharacterAvatarType @default(DEFAULT)
  avatarPresetId         String?
  avatarUrl              String?
  avatarUpdatedAt        DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  owner                  User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  scenario               Scenario?           @relation("ScenarioCharacters", fields: [scenarioId], references: [id], onDelete: SetNull)
  sessionCharacters      SessionCharacter[]
  representativeProfiles UserProfile[]       @relation("RepresentativeCharacter")

  @@index([ownerUserId, createdAt])
}

model CharacterAvatarAsset {
  id               String   @id @default(cuid())
  fileName         String
  contentType      String
  storageKey       String   @unique
  publicUrl        String
  width            Int?
  height           Int?
  fileSizeBytes    Int
  uploadedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  uploadedBy       User     @relation("CharacterAvatarAssetUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([uploadedByUserId, createdAt])
}

model SessionCharacter {
  id                    String                 @id @default(cuid())
  sessionId             String
  userId                String
  characterId           String
  status                SessionCharacterStatus @default(ACTIVE)
  currentHp             Int
  tempHp                Int
  conditionsJson        String
  inventorySnapshotJson String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  session               Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant           SessionParticipant     @relation("ParticipantSessionCharacter", fields: [sessionId, userId], references: [sessionId, userId], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  character             Character              @relation(fields: [characterId], references: [id])
  inventoryEntries      InventoryEntry[]
  combatTurnStates      CombatTurnState[]
  resource              SessionCharacterResource?

  @@unique([sessionId, userId])
  @@unique([sessionId, characterId])
}

model ItemDefinition {
  id               String           @id
  name             String
  itemType         String
  weightLb         Float?
  volumeCuFt       Float?
  damageDice       String?
  damageType       String?
  description      String?
  armorClassBase   Int?
  armorClassBonus  Int?
  armorStrengthRequirement Int?
  armorStealthDisadvantage Boolean?
  useEffect        String?
  packContentsJson String?
  propertiesJson   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  inventoryEntries InventoryEntry[]
}

model InventoryEntry {
  id                 String           @id @default(cuid())
  sessionCharacterId String
  itemDefinitionId   String
  quantity           Int              @default(1)
  containerEntryId   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessionCharacter   SessionCharacter @relation(fields: [sessionCharacterId], references: [id], onDelete: Cascade)
  itemDefinition     ItemDefinition   @relation(fields: [itemDefinitionId], references: [id])
  containerEntry     InventoryEntry?  @relation("InventoryContainer", fields: [containerEntryId], references: [id], onDelete: SetNull)
  containedEntries   InventoryEntry[] @relation("InventoryContainer")
  containerState     ContainerState?

  @@index([sessionCharacterId])
  @@index([itemDefinitionId])
  @@index([containerEntryId])
}

model ContainerState {
  inventoryEntryId  String         @id
  currentWeightLb   Float          @default(0)
  currentVolumeCuFt Float          @default(0)
  maxWeightLb       Float
  maxVolumeCuFt     Float
  integrity         String         @default("INTACT")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  inventoryEntry    InventoryEntry @relation(fields: [inventoryEntryId], references: [id], onDelete: Cascade)
}

model Scenario {
  id               String             @id
  title            String
  description      String?
  createdByUserId  String?
  sourceType       ScenarioSourceType @default(SYSTEM)
  baseScenarioId   String?
  thumbnailUrl     String?
  ruleSetId        String?
  difficulty       String?
  startLevel          Int              @default(1)
  recommendedEndLevel Int?
  license          ScenarioLicense
  attribution      String?
  startNodeId      String?
  npcsJson         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt           DateTime?
  creator          User?              @relation("ScenarioCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  baseScenario     Scenario?          @relation("ScenarioBase", fields: [baseScenarioId], references: [id], onDelete: SetNull)
  derivedScenarios Scenario[]         @relation("ScenarioBase")
  nodes            ScenarioNode[]
  assets           ScenarioAsset[]
  sessions         SessionScenario[]
  characters       Character[]        @relation("ScenarioCharacters")
  publication      ScenarioPublication?
  collaboratorGrants ScenarioCollaboratorGrant[]

  @@index([createdByUserId, updatedAt(sort: Desc), id])
  @@index([sourceType, createdAt])
  @@index([baseScenarioId, createdAt])
  @@index([startLevel, recommendedEndLevel, id])
  @@index([deletedAt, updatedAt(sort: Desc), id])
}

model ScenarioPublication {
  scenarioId        String   @id
  visibility        String   @default("UNPUBLISHED")
  moderationStatus  String   @default("VISIBLE")
  publishedAt       DateTime?
  revisionNumber    Int?
  forkCount         Int      @default(0)
  reportCount       Int      @default(0)
  appealCount       Int      @default(0)
  gmMode             String?
  tags               String[] @default([])
  estimatedMinutes   Int?
  recommendedPlayersMin Int?
  recommendedPlayersMax Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  scenario           Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([visibility, publishedAt(sort: Desc), scenarioId])
  @@index([moderationStatus, updatedAt(sort: Desc), scenarioId])
  @@index([updatedAt(sort: Desc), scenarioId])
  @@index([visibility, forkCount(sort: Desc), publishedAt(sort: Desc), scenarioId])
}

model ScenarioCollaboratorGrant {
  scenarioId String
  userId     String
  role       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([scenarioId, userId])
  @@index([userId, scenarioId])
}

model ScenarioAsset {
  id               String            @id @default(cuid())
  scenarioId       String
  kind             ScenarioAssetKind
  fileName         String
  contentType      String
  storageKey       String            @unique
  publicUrl        String
  width            Int?
  height           Int?
  fileSizeBytes    Int
  uploadedByUserId String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  scenario         Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  uploadedBy       User              @relation("ScenarioAssetUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([scenarioId, kind, createdAt])
}

model ScenarioNode {
  id               String   @id
  scenarioId       String
  nodeType         String   @default("story")
  title            String
  sceneText        String
  imageUrl         String?
  checkOptionsJson String
  transitionsJson  String
  cluesJson        String
  nodeMetaJson     String?
  fallbackNodeId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  scenario         Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, createdAt])
}

model SessionScenario {
  id         String                @id @default(cuid())
  sessionId  String
  scenarioId String
  sequence   Int
  status     SessionScenarioStatus @default(PLANNED)
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime              @default(now())
  session    Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scenario   Scenario              @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  gameState  GameState?
  nodes      SessionScenarioNode[]
  nodeVisits SessionNodeVisit[]
  reveals    SessionReveal[]
  turnLogs   TurnLog[]
  stateDiffs StateDiff[]
  combats    Combat[]

  @@unique([sessionId, sequence])
  @@index([scenarioId, id, sessionId])
  @@index([sessionId, status])
}

model SessionScenarioNode {
  id                String          @id @default(cuid())
  sessionScenarioId String
  originalNodeId    String?
  nodeId            String
  nodeType          String          @default("story")
  title             String
  sceneText         String
  imageUrl          String?
  checkOptionsJson  String
  transitionsJson   String
  cluesJson         String
  nodeMetaJson      String?
  fallbackNodeId    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessionScenario   SessionScenario @relation(fields: [sessionScenarioId], references: [id], onDelete: Cascade)
  nodeVisits        SessionNodeVisit[]
  runtimeState      SessionScenarioNodeRuntimeState?

  @@unique([sessionScenarioId, nodeId])
  @@index([sessionScenarioId])
  @@index([originalNodeId])
}

model SessionScenarioNodeRuntimeState {
  sessionScenarioId String
  nodeId            String
  version           Int                 @default(1)
  vttMapJson        String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  scenarioNode      SessionScenarioNode @relation(fields: [sessionScenarioId, nodeId], references: [sessionScenarioId, nodeId], onDelete: Cascade)

  @@id([sessionScenarioId, nodeId])
  @@index([sessionScenarioId, updatedAt])
}

model SessionNodeVisit {
  id                 String          @id @default(cuid())
  sessionScenarioId  String
  sessionScenarioNodeId String
  nodeId             String
  firstVisitedAt     DateTime        @default(now())
  lastVisitedAt      DateTime        @updatedAt
  visitCount         Int             @default(1)
  enteredByTurnLogId String?
  sessionScenario    SessionScenario @relation(fields: [sessionScenarioId], references: [id], onDelete: Cascade)
  scenarioNode       SessionScenarioNode @relation(fields: [sessionScenarioNodeId], references: [id], onDelete: Cascade)

  @@unique([sessionScenarioId, nodeId])
  @@index([sessionScenarioId, firstVisitedAt])
  @@index([sessionScenarioNodeId])
}

model SessionReveal {
  id                String          @id @default(cuid())
  sessionScenarioId String
  contentId         String
  contentKind       String          @default("clue")
  scope             String          @default("party")
  recipientId       String?
  recipientKey      String          @default("party")
  revealedAt        DateTime        @default(now())
  revealedBy        String          @default("system")
  reason            String?
  turnLogId         String?
  snapshotJson      String?
  sessionScenario   SessionScenario @relation(fields: [sessionScenarioId], references: [id], onDelete: Cascade)

  @@unique([sessionScenarioId, contentId, contentKind, scope, recipientKey])
  @@index([sessionScenarioId, revealedAt])
  @@index([sessionScenarioId, contentKind, revealedAt])
}

model GameState {
  sessionScenarioId   String          @id
  version             Int             @default(1)
  currentNodeId       String?
  phase               GamePhase       @default(LOBBY)
  flagsJson           String?
  updatedAt           DateTime        @updatedAt
  sessionScenario     SessionScenario @relation(fields: [sessionScenarioId], references: [id], onDelete: Cascade)
}

model PlayerAction {
  id                 String            @id @default(cuid())
  sessionId          String
  userId             String
  sessionCharacterId String?
  rawText            String
  inputType          ActionInputType
  actionScope        ActionScope
  queueStatus        ActionQueueStatus @default(PENDING)
  baseStateVersion   Int
  failureReason      String?
  clientCreatedAt    DateTime
  processedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  session            Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnLogs           TurnLog[]

  @@index([sessionId, queueStatus, createdAt])
  @@index([userId, createdAt])
}

model TurnLog {
  id                   String        @id @default(cuid())
  idempotencyKey       String?       @unique
  sessionId            String
  sessionScenarioId    String
  playerActionId       String?
  actorUserId          String?
  sessionCharacterId   String?
  turnNumber           Int
  rawInput             String?
  structuredActionJson String?
  diceResultJson       String?
  stateDiffJson        String?
  outcome              ActionOutcome
  narration            String?
  createdAt            DateTime      @default(now())
  session              Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionScenario      SessionScenario @relation(fields: [sessionScenarioId], references: [id], onDelete: Cascade)
  playerAction         PlayerAction? @relation(fields: [playerActionId], references: [id], onDelete: SetNull)
  diceRollLogs         DiceRollLog[]
  stateDiffs           StateDiff[]

  @@index([sessionId, createdAt])
  @@index([playerActionId, createdAt])
  @@unique([sessionId, turnNumber])
}

model DiceRollLog {
  id             String             @id @default(cuid())
  sessionId      String
  userId         String
  expression     String
  rollsJson      String
  modifier       Int
  total          Int
  advantageState DiceAdvantageState @default(NORMAL)
  reason         String?
  turnLogId      String?
  createdAt      DateTime           @default(now())
  session        Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnLog        TurnLog?           @relation(fields: [turnLogId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
}

model StateDiff {
  id                String          @id @default(cuid())
  sessionScenarioId String
  turnLogId         String?
  baseVersion       Int
  nextVersion       Int
  diffJson          String
  reason            String
  createdAt         DateTime        @default(now())
  sessionScenario   SessionScenario @relation(fields: [sessionScenarioId], references: [id], onDelete: Cascade)
  turnLog           TurnLog?        @relation(fields: [turnLogId], references: [id], onDelete: SetNull)

  @@index([sessionScenarioId, createdAt])
}

model Combat {
  id                String              @id @default(cuid())
  sessionId         String
  sessionScenarioId String
  status            CombatStatus        @default(ACTIVE)
  roundNo           Int                 @default(1)
  turnNo            Int                 @default(1)
  currentParticipantId String?
  startedAt         DateTime            @default(now())
  endedAt           DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  session           Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionScenario   SessionScenario     @relation(fields: [sessionScenarioId], references: [id], onDelete: Cascade)
  participants      CombatParticipant[]
  turnStates        CombatTurnState[]

  @@index([sessionId, status])
}

model CombatParticipant {
  id                 String           @id @default(cuid())
  combatId           String
  entityType         CombatEntityType
  sessionCharacterId String?
  tokenId            String?
  nameSnapshot       String
  currentHp          Int?
  maxHp              Int?
  armorClass         Int?
  speedFt            Int?
  conditionsJson     String?
  initiative         Int
  turnOrder          Int
  isAlive            Boolean          @default(true)
  isHostile          Boolean          @default(false)
  turnEndedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  combat             Combat           @relation(fields: [combatId], references: [id], onDelete: Cascade)
  turnStates         CombatTurnState[]

  @@index([combatId, turnOrder])
}

model CombatTurnState {
  id                       String           @id @default(cuid())
  combatId                 String
  combatParticipantId      String?
  roundNo                  Int
  turnNo                   Int
  sessionCharacterId       String?
  actionUsed               Boolean          @default(false)
  bonusActionUsed          Boolean          @default(false)
  reactionUsed             Boolean          @default(false)
  additionalActionGranted  Boolean          @default(false)
  attackActionWeaponId     String?
  attackActionWeaponIsLightMelee Boolean    @default(false)
  sneakAttackUsed          Boolean          @default(false)
  movementFtSpent          Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  combat                   Combat           @relation(fields: [combatId], references: [id], onDelete: Cascade)
  combatParticipant        CombatParticipant? @relation(fields: [combatParticipantId], references: [id], onDelete: Cascade)
  sessionCharacter         SessionCharacter? @relation(fields: [sessionCharacterId], references: [id], onDelete: Cascade)

  @@unique([combatId, roundNo, turnNo, combatParticipantId])
  @@index([combatParticipantId])
  @@index([sessionCharacterId])
}

model SessionCharacterResource {
  sessionCharacterId  String           @id
  secondWindAvailable Boolean          @default(true)
  actionSurgeUses     Int              @default(0)
  rageUses            Int              @default(0)
  rageActive          Boolean          @default(false)
  rageEndsAtRound     Int?
  rageEndsAtTurn      Int?
  frenzyActive        Boolean          @default(false)
  exhaustionLevel     Int              @default(0)
  hitDiceSpent        Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sessionCharacter    SessionCharacter @relation(fields: [sessionCharacterId], references: [id], onDelete: Cascade)
}

model AiTrace {
  id                String         @id @default(cuid())
  sessionId         String
  userId            String
  kind              AiTraceKind
  status            AiTraceStatus
  latencyMs         Int
  providerLatencyMs Int?
  attemptLatencies  Json?
  schemaValidationRetries Int?
  provider          String?
  model             String?
  promptVersion     String?
  attempts          Int?
  finishReason      String?
  providerRequestId String?
  promptTokenCount  Int?
  outputTokenCount  Int?
  cachedTokenCount  Int?
  totalTokenCount   Int?
  failureType       String?
  fallbackUsed      Boolean        @default(false)
  errorMessage      String?
  requestJson       String
  responseJson      String?
  createdAt         DateTime       @default(now())
  session           Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt, id])
  @@index([sessionId, kind, status, createdAt, id])
  @@index([sessionId, kind, promptVersion, model])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}
